# Docker build context excludes (contexts are the repo root).
# Keep secrets, dependencies and build output out of every image.

**/node_modules
**/dist
**/build
**/.turbo
**/.convex
**/.vite
**/.expo
**/coverage
**/test-results
**/playwright-report
**/blob-report
**/.git
infra/docker/.update-stage
infra/docker/.update-host.lock
infra/docker/.update.lock
infra/docker/.update-ready.json
infra/docker/.update-status.json
**/.gitattributes
**/*.log

# Secrets and local env files (templates stay).
.env
.env.*
**/.env
**/.env.*
!**/.env.example
**/.secrets
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*.provisionprofile
**/google-services.json
**/GoogleService-Info.plist
**/credentials.json
**/*service-account*.json
**/*firebase-adminsdk*.json

# Generated per-instance well-known document; infra writes the real one at runtime.
apps/web/public/.well-known

# Docs are not needed to build or run the stack.
docs
