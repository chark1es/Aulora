# Aulora self-hosted stack configuration.
#
#   cp .env.example .env
#   # edit the values marked CHANGE ME, then:
#   docker compose up -d --build
#   docker compose run --rm setup
#
# `.env` is gitignored. `setup` writes generated secrets (INSTANCE_SECRET,
# BETTER_AUTH_SECRET, VAPID_*) back into this file, so re-runs and restarts
# stay consistent. Never commit `.env`.

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aulora

# ---------------------------------------------------------------------------
# Instance identity
# ---------------------------------------------------------------------------
# Workspace/instance name. Also derives the Postgres database name that Convex
# uses: dashes become underscores (aulora -> aulora, aulora-team -> aulora_team).
# Changing this after first run requires a fresh Postgres volume.
INSTANCE_NAME=aulora

# Stable secret used to encrypt instance data (64 hex chars). Leave blank on
# the first run: the backend generates one and persists it in the `convex-data`
# volume, and `setup` copies it back here. Set it explicitly for deterministic
# restores, and keep it secret + backed up.
INSTANCE_SECRET=

# Public name shown by the workspace (set during `setup`).
WORKSPACE_NAME=Aulora

# ---------------------------------------------------------------------------
# Public origins (edit these for a real deployment)
# ---------------------------------------------------------------------------
# SITE_URL is the origin the web app is served from. The browser talks to
# Better Auth at <SITE_URL>/api/auth/*, proxied to the Convex HTTP-actions port
# so the session cookie is first-party.
SITE_URL=http://localhost:8080

# CONVEX_CLOUD_ORIGIN is the origin clients use for the Convex API + WebSocket.
CONVEX_CLOUD_ORIGIN=http://localhost:3210
CONVEX_URL=http://localhost:3210

# CONVEX_SITE_ORIGIN is the Convex HTTP-actions origin. It is also the JWT
# issuer/JWKS host, so the backend must be able to reach it. Locally that is the
# internal service name; behind an edge proxy set it to the public site origin
# and route /api/auth/* there (see proxy/README.md).
CONVEX_SITE_ORIGIN=http://convex-backend:3211

# Extra origins Better Auth accepts for callbacks, comma-separated. SITE_URL is
# always trusted and the aulora:// native scheme is built in.
# TRUSTED_ORIGINS=https://chat.example.com

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
WEB_PORT=8080
CONVEX_API_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Owner account created by `setup` (CHANGE ME)
# ---------------------------------------------------------------------------
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please-32-chars-min
# Display name for the owner; defaults to WORKSPACE_NAME.
OWNER_NAME=Aulora Owner

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Better Auth signing secret (32+ chars). Leave blank to have `setup` generate
# one and store it here. Changing it invalidates existing sessions.
BETTER_AUTH_SECRET=

# One-time token gating POST /setup/initialize. Leave blank to let `setup`
# generate a throwaway one; `setup` removes it from the deployment after a
# successful first init.
SETUP_TOKEN=

# Local email/password sign-in. Disable signup after the owner exists if you
# want an invite-only instance.
AUTH_LOCAL_ENABLED=true
AUTH_LOCAL_SIGNUP=true

# Built-in OAuth providers: each appears in the well-known document only when
# both ID and SECRET are set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Generic OIDC (Keycloak, Authentik, Authelia, Okta, Zitadel, Entra ID). All of
# ISSUER, DISCOVERY_URL, CLIENT_ID and CLIENT_SECRET are required to enable it.
# OIDC_DISPLAY_NAME='Acme SSO'
# OIDC_ISSUER='https://idp.example.com/realms/acme'
# OIDC_DISCOVERY_URL='https://idp.example.com/realms/acme/.well-known/openid-configuration'
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES='openid profile email groups'
# OIDC_GROUP_CLAIM=groups
# OIDC_GROUP_ROLE_MAP='{"aulora-admins":"Admin"}'

# ---------------------------------------------------------------------------
# Web push (VAPID). `setup` generates these if blank. Keep them stable:
# rotating them invalidates every existing push subscription.
# ---------------------------------------------------------------------------
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Postgres (CHANGE ME)
# ---------------------------------------------------------------------------
POSTGRES_USER=convex
POSTGRES_PASSWORD=aulora-postgres
# Must match POSTGRES_USER/PASSWORD above and must NOT include a database name.
POSTGRES_URL=postgresql://convex:aulora-postgres@postgres:5432
# Local Postgres has no TLS; leave 1 unless your Postgres requires SSL.
DO_NOT_REQUIRE_SSL=1

# ---------------------------------------------------------------------------
# Object storage (MinIO). `setup`-independent; buckets are created by minio-init.
# To use an external S3 instead, set S3_ENDPOINT_URL to its endpoint and the
# two credentials below to its keys (or remove the S3_* block in the compose
# file to fall back to the backend's local volume storage).
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=aulora
MINIO_ROOT_PASSWORD=aulora-minio-secret
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
# MinIO and most S3-compatible stores need path-style addressing and do not
# implement the AWS SDK's default payload checksums / SSE headers. Set these to
# false/remove them only for real AWS S3.
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_DISABLE_CHECKSUMS=true
AWS_S3_DISABLE_SSE=true
S3_STORAGE_EXPORTS_BUCKET=convex-snapshot-exports
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=convex-snapshot-imports
S3_STORAGE_MODULES_BUCKET=convex-modules
S3_STORAGE_FILES_BUCKET=convex-user-files
S3_STORAGE_SEARCH_BUCKET=convex-search-indexes

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
RUST_LOG=info
