# Aulora self-hosted stack configuration.
#
#   cp .env.example .env
#   # edit the values marked CHANGE ME, then:
#   docker compose up -d --build
#   docker compose run --rm setup
#
# `.env` is gitignored. `setup` writes generated secrets (INSTANCE_SECRET,
# BETTER_AUTH_SECRET, VAPID_*, AULORA_ENCRYPTION_KEY) back into this file, so
# re-runs and restarts stay consistent. Never commit `.env`: it holds the EKM
# master key (the KEK), the root of data confidentiality.

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aulora

# ---------------------------------------------------------------------------
# Instance identity
# ---------------------------------------------------------------------------
# Workspace/instance name. Also derives the Postgres database name that Convex
# uses: dashes become underscores (aulora -> aulora, aulora-team -> aulora_team).
# Changing this after first run requires a fresh Postgres volume.
INSTANCE_NAME=aulora

# Stable instance secret (64 hex chars) that authorizes the Convex admin key.
# Leave blank on the first run: the backend generates one and persists it in the
# `convex-data` volume, and `setup` copies it back here. Set it explicitly for
# deterministic restores, and keep it secret + backed up. The `local` provider
# uses this only as a legacy fallback when the dedicated AULORA_ENCRYPTION_KEY
# below is unset; that key is the default and the real root of data
# confidentiality (see "Server-side encryption").
INSTANCE_SECRET=

# Public name shown by the workspace (set during `setup`).
WORKSPACE_NAME=Aulora

# ---------------------------------------------------------------------------
# Public origins (edit these for a real deployment)
# ---------------------------------------------------------------------------
# SITE_URL is the origin the web app is served from. The browser talks to
# Better Auth at <SITE_URL>/api/auth/*, proxied to the Convex HTTP-actions port
# so the session cookie is first-party.
SITE_URL=http://localhost:8080

# CONVEX_CLOUD_ORIGIN is the origin clients use for the Convex API + WebSocket.
CONVEX_CLOUD_ORIGIN=http://localhost:3210
CONVEX_URL=http://localhost:3210

# CONVEX_SITE_ORIGIN is the Convex HTTP-actions origin. It is also the JWT
# issuer/JWKS host, so the backend must be able to reach it. Locally that is the
# internal service name; behind an edge proxy set it to the public site origin
# and route /api/auth/* there (see proxy/README.md).
CONVEX_SITE_ORIGIN=http://convex-backend:3211

# Extra origins Better Auth accepts for callbacks, comma-separated. SITE_URL is
# always trusted and the aulora:// native scheme is built in. List every
# additional web origin users reach the app on, for example a Tailscale IP
# (`http://100.64.0.10:8080`). Required whenever the web app is reached on a
# different hostname/IP than SITE_URL, otherwise Better Auth rejects the
# browser Origin. After editing, re-run `docker compose run --rm setup`.
# TRUSTED_ORIGINS=https://chat.example.com,http://100.64.0.10:8080

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
WEB_PORT=8080
CONVEX_API_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host port for the optional bundled Vault (compose profile `ekm`).
VAULT_PORT=8200

# ---------------------------------------------------------------------------
# Owner account created by `setup` (CHANGE ME)
# ---------------------------------------------------------------------------
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please-32-chars-min
# Display name for the owner; defaults to WORKSPACE_NAME.
OWNER_NAME=Aulora Owner

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Better Auth signing secret (32+ chars). Leave blank to have `setup` generate
# one and store it here. Changing it invalidates existing sessions.
BETTER_AUTH_SECRET=

# One-time token gating POST /setup/initialize. Leave blank to let `setup`
# generate a throwaway one; `setup` removes it from the deployment after a
# successful first init.
SETUP_TOKEN=

# Local email/password sign-in. Disable signup after the owner exists if you
# want an invite-only instance.
AUTH_LOCAL_ENABLED=true
AUTH_LOCAL_SIGNUP=true
# Minimum password length for local email/password accounts (default 8). Lower
# it only for throwaway test deployments that need easy-to-type demo passwords.
# AUTH_MIN_PASSWORD_LENGTH=1

# Built-in OAuth providers: each appears in the well-known document only when
# both ID and SECRET are set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Generic OIDC (Keycloak, Authentik, Authelia, Okta, Zitadel, Entra ID). All of
# ISSUER, DISCOVERY_URL, CLIENT_ID and CLIENT_SECRET are required to enable it.
# OIDC_DISPLAY_NAME='Acme SSO'
# OIDC_ISSUER='https://idp.example.com/realms/acme'
# OIDC_DISCOVERY_URL='https://idp.example.com/realms/acme/.well-known/openid-configuration'
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES='openid profile email groups'
# OIDC_GROUP_CLAIM=groups
# OIDC_GROUP_ROLE_MAP='{"aulora-admins":"Admin"}'

# ---------------------------------------------------------------------------
# Server-side encryption (default)
#
# The server seals message content and files with AES-256-GCM envelope
# encryption: each value is sealed with a per-scope data key (DEK) derived
# (HKDF-SHA256) from the master key, the workspace salt and the record scope.
# The master key (the KEK) is the root of data confidentiality. Setup persists
# it here and configures it in the backend deployment environment. Protect
# backend state and raw database dumps as potentially secret-bearing.
#
# The default provider is `local`: the server derives the master key from
# AULORA_ENCRYPTION_KEY (base64, 32 bytes). `setup` generates that key on the
# first run and persists it here, so the default `docker compose up` needs no
# extra services. Keep it secret and back it up separately from the database:
# if the key is lost, the existing data is unreadable.
# ---------------------------------------------------------------------------
# Provider for the default path. Leave as `local`; the remote providers listed
# under "Optional: external key manager" below are advanced alternatives.
AULORA_EKM_PROVIDER=local
# Logical name of the master key (the KEK).
AULORA_EKM_KEY_ID=aulora-kek
# Master-key version sealed into every envelope header. Bump it when you rotate
# the master key, so old values stay readable and new writes use the new key.
AULORA_ENCRYPTION_KEY_VERSION=1
# Base64 of a 32-byte master key. `setup` fills this in on first run and
# persists it here; keep it secret and back it up with this file. INSTANCE_SECRET
# is only a legacy fallback the `local` provider uses when this is unset.
AULORA_ENCRYPTION_KEY=
# Set to false only to disable encryption entirely (fresh installs).
AULORA_ENCRYPTION_ENABLED=true

# ---------------------------------------------------------------------------
# Optional: external key manager (EKM)
#
# Advanced alternative to the local default. The provider interface accepts
# these without code changes; the default `docker compose up` starts none of
# this. Remote providers are unwrap-only: AULORA_KEK_WRAPPED is the master key
# encrypted by that key manager, and the server asks it to unwrap the key on
# startup/cron.
# ---------------------------------------------------------------------------
# Base64 ciphertext of the master key, wrapped by the external key manager.
# Required by every remote provider. Never commit it.
AULORA_KEK_WRAPPED=

# --- Vault Transit (`AULORA_EKM_PROVIDER=vault`) ---
# Point VAULT_ADDR and VAULT_TOKEN at the bundled `vault` service (compose
# profile `ekm`) or an external Vault. VAULT_TOKEN authorizes the unwrap and is
# also the bundled dev Vault's root token, so set it to your own value (e.g.
# `aulora-dev-root`) or a real Vault token; keep it secret.
#   docker compose --profile ekm up -d
# The bundled Vault is dev mode and in-memory, so its KEK is lost on restart;
# for production use a persistent Vault and back up the KEK (and the unseal
# keys) separately. vault-init writes AULORA_KEK_WRAPPED back into this file.
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=aulora-dev-root
# VAULT_TRANSIT_MOUNT=transit
# VAULT_NAMESPACE=

# --- AWS KMS (`AULORA_EKM_PROVIDER=aws-kms`) ---
# AWS_REGION is shared with the S3 settings above; set AWS_KMS_KEY_ID to the
# KMS key id or ARN.
# AWS_KMS_KEY_ID=

# --- GCP KMS (`AULORA_EKM_PROVIDER=gcp-kms`) ---
# Full resource name of the key, for example
# projects/P/locations/L/keyRings/R/cryptoKeys/K.
# GCP_KMS_KEY_NAME=

# --- HTTP unwrap proxy (`AULORA_EKM_PROVIDER=http`) ---
# Your own service exposing POST /v1/unwrap { wrappedKey, kekId } -> { key }.
# EKM_PROXY_URL=
# EKM_PROXY_TOKEN=

# ---------------------------------------------------------------------------
# Web push (VAPID). `setup` generates these if blank. Keep them stable:
# rotating them invalidates every existing push subscription.
# ---------------------------------------------------------------------------
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Mobile push relay (optional). The Convex action reads PUSH_RELAY_URL and
# PUSH_RELAY_TOKEN; the `push-relay` compose profile reads the provider keys
# below. All are blank/off by default: without them, mobile push is disabled and
# sends never fail. Enable with `docker compose --profile push-relay up -d`.
# ---------------------------------------------------------------------------
# Base URL of the relay as reachable from Convex, and the shared secret both
# sides send as `Authorization: Bearer`.
PUSH_RELAY_URL=
PUSH_RELAY_TOKEN=
# Host port for the relay container.
PUSH_RELAY_PORT=8790
# Stable opaque server id echoed in wakeups; defaults to SITE_URL.
AULORA_SERVER_ID=
# --- APNs (iOS) ---
# APNS_KEY_P8 (inline, \n-escaped) or APNS_KEY_PATH (a .p8 file), plus these
# four, enable iOS push.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=dev.spwnd.aulora
APNS_KEY_P8=
APNS_KEY_PATH=
APNS_ENVIRONMENT=production
# --- FCM (Android) ---
# Android push: prefer service-account JSON for automatic token renewal.
# A short-lived FCM_ACCESS_TOKEN is also accepted for testing.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=
FCM_ACCESS_TOKEN=
# Set to 1 to accept de-Googled phones that register a UnifiedPush endpoint.
UNIFIEDPUSH_ENABLED=

# ---------------------------------------------------------------------------
# Voice/video calls (optional). Calls are peer-to-peer WebRTC with signalling
# over Convex, so no media server is required. Set a JSON array of ICE servers
# to use your own STUN/TURN; blank falls back to the client's public STUN.
# AULORA_ICE_SERVERS=[{"urls":["stun:stun.example.com:3478"]}]
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Workspace updates (optional). The desktop app updates itself from the signed
# GitHub release feed. This stack updates from the same release, on the host:
#   ./update.sh --check     # print the plan
#   ./update.sh --apply     # fast-forward to the release tag and redeploy
#   ./update.sh --watch     # enables owner-only update controls in settings
# AULORA_AUTO_UPDATE=true downloads new releases; installation waits for Restart.
# A git clone is required. Dirty checkouts are refused. .env and volumes stay.
# Coolify redeploys from its own git source instead of this script.
# ---------------------------------------------------------------------------
AULORA_AUTO_UPDATE=false
# stable ignores prereleases. beta accepts them.
AULORA_UPDATE_CHANNEL=stable
# Seconds between checks in --watch. Minimum 60.
AULORA_UPDATE_INTERVAL_SECONDS=21600
# Defaults: GitHub latest.json, then the GitHub releases API for chark1es/Aulora.
# AULORA_UPDATE_MANIFEST_URL=https://github.com/chark1es/Aulora/releases/latest/download/latest.json
# AULORA_UPDATE_GITHUB_REPO=chark1es/Aulora

# ---------------------------------------------------------------------------
# Nightly backups (optional). Enable with:
#   docker compose --profile backups up -d --build
# Each run does `pg_dump` + `convex export` and uploads both to the S3 bucket
# below (MinIO by default), then records the result in the admin panel. The
# runner generates BACKUP_TOKEN if blank and writes it back here.
# ---------------------------------------------------------------------------
# UTC hour (0-23) the runner starts its nightly run.
BACKUP_HOUR_UTC=3
# Set to false to keep the container idle without removing the profile.
BACKUP_ENABLED=true
# Destination bucket and how many local run directories to keep on the volume.
BACKUP_BUCKET=aulora-backups
BACKUP_RETENTION=7
# Shared secret the runner uses to record results; blank means "generate one".
BACKUP_TOKEN=

# ---------------------------------------------------------------------------
# Postgres (CHANGE ME)
# ---------------------------------------------------------------------------
POSTGRES_USER=convex
POSTGRES_PASSWORD=aulora-postgres
# Must match POSTGRES_USER/PASSWORD above and must NOT include a database name.
POSTGRES_URL=postgresql://convex:aulora-postgres@postgres:5432
# Local Postgres has no TLS; leave 1 unless your Postgres requires SSL.
DO_NOT_REQUIRE_SSL=1

# ---------------------------------------------------------------------------
# Object storage (MinIO). `setup`-independent; buckets are created by minio-init.
# To use an external S3 instead, set S3_ENDPOINT_URL to its endpoint and the
# two credentials below to its keys (or remove the S3_* block in the compose
# file to fall back to the backend's local volume storage).
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=aulora
MINIO_ROOT_PASSWORD=aulora-minio-secret
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
# MinIO and most S3-compatible stores need path-style addressing and do not
# implement the AWS SDK's default payload checksums / SSE headers. Set these to
# false/remove them only for real AWS S3.
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_DISABLE_CHECKSUMS=true
AWS_S3_DISABLE_SSE=true
S3_STORAGE_EXPORTS_BUCKET=convex-snapshot-exports
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=convex-snapshot-imports
S3_STORAGE_MODULES_BUCKET=convex-modules
S3_STORAGE_FILES_BUCKET=convex-user-files
S3_STORAGE_SEARCH_BUCKET=convex-search-indexes

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
RUST_LOG=info

# Commercial license validation uses the bundled Aulora authority by default.
# Override both only when the operator has an approved alternate authority.
AULORA_LICENSE_SERVER_URL=
# PEM public key with literal \n separators. Never configure the private key here.
AULORA_LICENSE_PUBLIC_KEY=
