# Aulora web container: static SPA + the two routes that must be first-party.
#
# This is an nginx *template*: the official nginx image envsubst-expands it from
# /etc/nginx/templates into /etc/nginx/conf.d at startup. `${NGINX_CLIENT_MAX_BODY_SIZE}`
# is the only substituted value here (see web.Dockerfile); nginx runtime
# variables such as `$http_upgrade` are left untouched because they are not
# environment variables.
#
# Routing contract (see ../proxy/README.md for the production edge):
#   /                 -> the built SPA, with history fallback
#   /.well-known/aulora.json -> live discovery from Convex HTTP actions (3211)
#   /.well-known/*    -> other per-instance documents (mounted volume)
#   /api/auth/*       -> Convex HTTP actions (convex-backend:3211), same origin,
#                        so the Better Auth session cookie is first-party.
#   /api/webhooks/*   -> Convex HTTP actions (convex-backend:3211): incoming webhooks.
#   /api/*            -> Convex backend (convex-backend:3210), same origin, with
#                        WebSocket upgrade for the live sync channel. Serving
#                        Convex from the web origin lets one HTTPS URL (a tunnel,
#                        a reverse proxy, `slim`, a phone on the LAN) run the
#                        whole app without exposing the API port separately.
#   /livekit/*        -> the optional screen-streaming server (profile
#                        `streaming`), signalling only; media uses 7881/7882.
#
# Operators may move these proxies to their edge proxy instead; in that case
# point these locations at the edge/Gateway or leave them and let the edge
# handle it ahead of this container.

# WebSocket upgrade passthrough for the Convex sync channel (and HTTP actions).
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Abuse limits for the transcription audio WebSocket. Zones live in the http
# context; the per-location directives below apply them. `limit_conn` is keyed
# on the immediate peer, so behind a reverse proxy (Coolify/Traefik, Caddy, a
# cloud LB) or NAT every participant shares one address; it is only a coarse
# backstop. The transcriber enforces the real caps per identity, per session
# and for unauthenticated sockets. Keep this at the hard seat ceiling so a
# full call behind one proxy address is never refused.
limit_req_zone $binary_remote_addr zone=transcribe_req:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=transcribe_conn:10m;

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Do not leak the nginx version.
  server_tokens off;

  # Request-body cap, applied before Convex sees the upload. Set
  # NGINX_CLIENT_MAX_BODY_SIZE (env, nginx size notation) at least as large as
  # the effective max upload: the instance setting (instanceSettings
  # `maxUploadBytes`, managed in the admin Storage panel) or UPLOAD_MAX_BYTES.
  # The default (100m) comfortably covers the 25 MiB built-in upload cap.
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  # Workspace discovery comes from the backend so the main URL works without
  # a generated file and auth/branding changes take effect immediately.
  location = /.well-known/aulora.json {
    proxy_pass http://convex-backend:3211;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Advertise SITE_URL for client API + WebSocket traffic, which this
    # gateway already forwards at /api/. Replace any incoming client header.
    proxy_set_header X-Aulora-Api-Proxy "same-origin";
    proxy_buffering off;
  }

  # Other public documents, including aulora-update.json, are written into
  # the `web-well-known` volume. Always revalidate them after a redeploy.
  location ^~ /.well-known/ {
    root /var/www;
    default_type application/json;
    add_header Access-Control-Allow-Origin "*" always;
    expires -1;
    try_files $uri =404;
  }

  # Hashed build assets (vite emits content-hashed filenames): safe to cache
  # for a year, and `immutable` lets the browser skip even a conditional
  # revalidation. A new deploy ships new names, so old URLs are never reused.
  location ^~ /assets/ {
    # `add_header` in a location replaces inheritance, so repeat the security
    # headers here instead of dropping them for every hashed asset.
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()" always;
    try_files $uri =404;
  }

  # Unhashed shell files must never be served stale: a cached service worker or
  # theme bootstrap would pin clients to an old build.
  location = /index.html {
    expires -1;
  }
  location = /push-sw.js {
    expires -1;
  }
  location = /theme-boot.js {
    expires -1;
  }
  location = /favicon.svg {
    expires 1d;
  }

  # First-party auth. Keep Set-Cookie, Origin and forwarding headers intact.
  location /api/auth/ {
    proxy_pass http://convex-backend:3211;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Origin $http_origin;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  # Incoming webhooks: other tools POST messages to /api/webhooks/<id>/<secret>.
  # Convex HTTP actions again (3211), so the longer prefix must beat /api/.
  location /api/webhooks/ {
    proxy_pass http://convex-backend:3211;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    client_max_body_size 128k;
  }

  # Convex backend on the same origin: queries, mutations, actions, file
  # fetches and the `/api/<version>/sync` WebSocket. A longer prefix
  # (`/api/auth/`) still wins for Better Auth, so auth keeps going to 3211.
  location /api/ {
    proxy_pass http://convex-backend:3210;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Screen-streaming signalling (LiveKit), same origin so it needs no extra
  # domain, certificate or CSP entry. The upstream is resolved per request
  # through Docker's DNS: with the `streaming` profile off the name does not
  # exist, and a static `proxy_pass` would stop nginx from starting at all.
  location /livekit/ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $livekit_upstream http://livekit:7880;
    rewrite ^/livekit/(.*)$ /$1 break;
    proxy_pass $livekit_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Transcription audio WebSocket (compose profile `transcription`). Each
  # participant streams its own microphone here as 16 kHz mono PCM16; the
  # upstream path is `/ws`. The upstream is resolved per request so nginx still
  # starts when the optional container is absent.
  # Only the audio WebSocket is public. The transcriber's health, docs and
  # admin routes stay on the internal network (Convex reaches them directly).
  location = /transcribe/ws {
    resolver 127.0.0.11 valid=10s ipv6=off;
    # A client opens one audio socket; cap connection churn before the request
    # reaches the transcriber. The connection cap is a backstop sized to the
    # hard seat ceiling (MAX_CALL_SEATS); it is per peer address, which is the
    # proxy or NAT address in most deployments, so the transcriber's
    # per-identity, per-session and pre-auth caps are the real abuse controls.
    limit_req zone=transcribe_req burst=40 nodelay;
    limit_conn transcribe_conn 64;
    set $transcriber_upstream http://transcriber:8787;
    rewrite ^ /ws break;
    proxy_pass $transcriber_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    # Each frame is tiny; the cap rejects an abusive client early.
    client_max_body_size 64k;
  }

  # The guest call page is opened from a private link: it must not be indexed,
  # must not send a Referer, and must not be cached. The link token itself
  # lives in the URL fragment, which never reaches this server. `add_header` in
  # a location replaces inheritance, so the baseline headers are repeated.
  location = /call/guest {
    try_files /index.html =404;
    expires -1;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()" always;
  }

  # SPA history fallback.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Baseline security headers. The full policy (HSTS, CSP at the edge) lives in
  # proxy/README.md; these are safe defaults even without an edge.
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()" always;

  gzip on;
  # Level 6 recovers most of the ratio for the multi-MB JS chunk; the default
  # (1) leaves a meaningful fraction on every cold load.
  gzip_comp_level 6;
  # Tiny responses are not worth the CPU or the variant.
  gzip_min_length 1024;
  # Required once a shared cache can store the compressed body.
  gzip_vary on;
  # Serve a precompressed `.gz` sibling when one exists (the docs build emits
  # them; a web build host may too), falling back to on-the-fly compression.
  gzip_static on;
  gzip_types text/plain text/css application/json application/javascript application/wasm image/svg+xml;
  # Brotli is NOT compiled into the official nginx:1.27-alpine image
  # (`nginx -V` has no ngx_brotli). Leave these off; a build that adds the
  # module can enable `brotli`/`brotli_static` here without an `unknown
  # directive` failure on the stock image.
  # brotli on;
  # brotli_comp_level 6;
  # brotli_static on;
  # brotli_types text/plain text/css application/json application/javascript application/wasm image/svg+xml;
}
