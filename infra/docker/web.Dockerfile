# syntax=docker/dockerfile:1.7
#
# Builds the Aulora web SPA and serves it with nginx.
#   - multi-stage: Bun build -> nginx (alpine)
#   - history fallback for the TanStack Router SPA
#   - /.well-known/aulora.json proxied to live backend discovery
#   - other /.well-known/ documents served from the `web-well-known` volume
#   - /api/auth/ proxied to the Convex HTTP-actions origin for first-party cookies
#
# Build context is the repo root; see ../../.dockerignore.

# Only the package manifests, so the dependency layer below is rebuilt when a
# dependency changes and not on every source edit. The copied sources are
# stripped to their package.json files; a later COPY --from is keyed on content,
# so unchanged manifests keep the install cached.
FROM oven/bun:1.4.4 AS manifests
WORKDIR /src
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY apps/docs/package.json apps/docs/
COPY packages ./packages
RUN find packages -type f ! -name package.json -delete \
  && find packages -type d -empty -delete

FROM oven/bun:1.4.4 AS build
WORKDIR /app

# Public values baked into the build-time dev well-known document. The runtime
# document is generated by `setup` and mounted over this path, so these only
# matter for a plain `vite build`.
ARG INSTANCE_NAME=Aulora
ARG SITE_URL=http://localhost:8080
ARG CONVEX_URL=http://localhost:3210
ENV INSTANCE_NAME=$INSTANCE_NAME
ENV SITE_URL=$SITE_URL
ENV CONVEX_URL=$CONVEX_URL

COPY --from=manifests /src ./
# The package cache survives between builds, so even a changed dependency only
# downloads what is new.
RUN --mount=type=cache,target=/bun-cache \
  BUN_INSTALL_CACHE_DIR=/bun-cache bun install --frozen-lockfile

# Sources come after the install so editing them never reinstalls.
COPY turbo.json tsconfig.json biome.json ./
COPY LICENSE NOTICE COMMERCIAL.md THIRD_PARTY_NOTICES.md ./
COPY licenses ./licenses
COPY scripts/legal-notices.mjs ./scripts/legal-notices.mjs
COPY packages ./packages
COPY apps/web ./apps/web

RUN bun run --cwd apps/web build

FROM nginx:1.30.6-alpine AS runtime
# Maximum request body forwarded through this origin. The official nginx image
# envsubst-expands files in /etc/nginx/templates into /etc/nginx/conf.d at
# startup, substituting only environment variables (nginx's own `$var` tokens
# are left alone). Raise NGINX_CLIENT_MAX_BODY_SIZE to match the effective max
# upload whenever clients upload through this origin.
ENV NGINX_CLIENT_MAX_BODY_SIZE=100m
COPY infra/docker/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
