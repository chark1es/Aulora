{
  "name": "@aulora/ui-web",
  "version": "0.0.0",
  "private": true,
  "description": "Aulora React DOM design-system primitives: buttons, inputs, cards, text, dot grid, logo and the particle spinner.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
