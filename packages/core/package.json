{
  "name": "@aulora/core",
  "version": "1.1.0",
  "private": true,
  "description": "Aulora shared client logic: server profiles, well-known validation, permissions, unread math.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./attachments": "./src/attachments.ts",
    "./blurhash": "./src/blurhash.ts",
    "./chat": "./src/chat/index.ts",
    "./kanban": "./src/kanban.ts",
    "./notes": "./src/notes/index.ts",
    "./outbox": "./src/outbox/index.ts",
    "./permissions": "./src/permissions.ts",
    "./search": "./src/search/index.ts",
    "./updates": "./src/updates.ts",
    "./voice": "./src/voice/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@types/node": "26.6.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
