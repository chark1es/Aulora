# Copy to .env.local for the Convex CLI (self-hosted). Never commit real values.
CONVEX_SELF_HOSTED_URL='http://127.0.0.1:3210'
CONVEX_SELF_HOSTED_ADMIN_KEY='<instance>|<admin-key>'

# Deployment env vars: set these with `bunx convex env set NAME value`
# (they live in Convex, not in this file). Only BETTER_AUTH_SECRET and
# SETUP_TOKEN are required; everything else is optional and only enabled when
# both parts of a provider are present.
#
# BETTER_AUTH_SECRET=<random 32+ char string>
# SITE_URL='http://127.0.0.1:3211'
# SETUP_TOKEN=<one-time setup token; remove after setup>
# AUTH_LOCAL_ENABLED=true
# AUTH_LOCAL_SIGNUP=true
# TRUSTED_ORIGINS='http://localhost:5173,https://chat.example.com'
#
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
#
# OIDC_DISPLAY_NAME='Acme SSO'
# OIDC_ISSUER='https://idp.example.com/realms/acme'
# OIDC_DISCOVERY_URL='https://idp.example.com/realms/acme/.well-known/openid-configuration'
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES='openid profile email groups'
# OIDC_GROUP_CLAIM=groups
# OIDC_GROUP_ROLE_MAP='{"aulora-admins":"Admin","aulora-mods":["Mod","Helper"]}'
