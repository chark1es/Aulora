{
  "name": "@aulora/convex",
  "version": "1.2.1",
  "private": true,
  "description": "Aulora Convex backend: schema, auth, queries, mutations, HTTP routes.",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy --yes",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('.turbo',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aulora/core": "workspace:*",
    "@convex-dev/better-auth": "0.12.5",
    "better-auth": "1.6.33",
    "convex": "1.48.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.6.5",
    "convex-test": "0.0.64",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
