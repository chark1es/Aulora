{
  "name": "@aulora/bot",
  "version": "1.1.0",
  "private": true,
  "description": "TypeScript SDK for Aulora bots: exchanges a bot API token for a short-lived JWT, polls events, and calls Convex as the bot.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@types/node": "26.6.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
