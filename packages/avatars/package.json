{
  "name": "@aulora/avatars",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic Blobatar avatars for Aulora web, seeded by stable user/icon id. Native entrypoint is Phase 4.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@blobatar/react": "2.7.0",
    "blobatar": "2.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
