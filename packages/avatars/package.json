{
  "name": "@aulora/avatars",
  "version": "1.0.1",
  "private": true,
  "description": "Deterministic Blobatar avatars for Aulora web and native clients.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aulora/tokens": "workspace:*",
    "@blobatar/react": "2.7.0",
    "blobatar": "2.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.86.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
