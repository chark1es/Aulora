{
  "name": "@aulora/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "Aulora device-side MLS (RFC 9420) engine, encrypted key storage adapters and a Web Worker wrapper.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker-entry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.3.0",
    "ts-mls": "1.6.4"
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@types/node": "26.6.3",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
