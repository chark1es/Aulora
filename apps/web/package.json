{
  "name": "@aulora/web",
  "version": "1.3.0",
  "private": true,
  "description": "Aulora web client: Vite + React SPA with TanStack Router, Tailwind v3 and Convex + Better Auth.",
  "type": "module",
  "scripts": {
    "well-known": "bun run scripts/write-well-known.ts",
    "dev": "bun run well-known && vite",
    "build": "bun run well-known && vite build && node ../../scripts/legal-notices.mjs --web",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aulora/avatars": "workspace:*",
    "@aulora/core": "workspace:*",
    "@aulora/tokens": "workspace:*",
    "@aulora/ui-web": "workspace:*",
    "@convex-dev/better-auth": "0.12.5",
    "@mediapipe/tasks-vision": "1.1.1",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tanstack/react-router": "1.170.46",
    "better-auth": "1.6.33",
    "convex": "1.48.0",
    "livekit-client": "2.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
