# Copy to apps/web/.env.local for local development. Never commit real values.
#
# The web app reads no backend URL from this file at runtime; scripts/write-well-known.ts
# turns the public values below into public/.well-known/aulora.json (gitignored).
# Secrets are only checked for presence so the local document mirrors the server.

INSTANCE_NAME=Aulora
SITE_URL=http://localhost:5173
CONVEX_URL=http://127.0.0.1:3210
AULORA_VERSION=1.0.0
API_VERSION=1
ICON_SEED=aulora:server:local

# Vite dev server only: forwards /api/auth/* to the Convex HTTP-actions port so
# the session cookie is first-party. In production Caddy does this on the site origin.
AULORA_AUTH_PROXY_TARGET=http://127.0.0.1:3211

AUTH_LOCAL_ENABLED=true
AUTH_LOCAL_SIGNUP=true

# Built-in OAuth (github, google, microsoft, apple): set both values to publish one.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Generic OIDC: set all four to publish an "oidc" provider.
# OIDC_ISSUER=
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Acme SSO
# OIDC_SCOPES=openid profile email
