{
  "name": "@aulora/mobile",
  "version": "1.2.0",
  "private": true,
  "description": "Aulora mobile: Expo (iOS + Android) client with Expo Router, NativeWind, server-side encryption and expo-notifications.",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react",
        "react-native-gesture-handler",
        "react-native-webrtc"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aulora/avatars": "workspace:*",
    "@aulora/core": "workspace:*",
    "@aulora/tokens": "workspace:*",
    "@aulora/ui-native": "workspace:*",
    "@convex-dev/better-auth": "0.12.5",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "better-auth": "1.6.22",
    "convex": "1.46.0",
    "expo": "~58.0.16",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "3.4.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webrtc": "155.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@expo/metro-runtime": "~58.0.14",
    "@types/react": "19.3.0",
    "babel-preset-expo": "~58.0.18",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
