{
  "name": "@aulora/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Aulora mobile: Expo (iOS + Android) client with Expo Router, NativeWind, MLS over an OpenMLS boundary, and expo-notifications.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "format": "biome format --write .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aulora/avatars": "workspace:*",
    "@aulora/core": "workspace:*",
    "@aulora/crypto": "workspace:*",
    "@aulora/tokens": "workspace:*",
    "@aulora/ui-native": "workspace:*",
    "@convex-dev/better-auth": "0.12.5",
    "@react-native-async-storage/async-storage": "3.1.1",
    "better-auth": "1.6.15",
    "convex": "1.46.0",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@aulora/config": "workspace:*",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@expo/metro-runtime": "~57.0.16",
    "@types/react": "19.3.0",
    "babel-preset-expo": "~57.0.13",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
