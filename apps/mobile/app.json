{
  "expo": {
    "name": "Aulora",
    "slug": "aulora",
    "description": "Team chat you run on your own server, with channels, direct messages, threads, calls, and encrypted messages.",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "aulora",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.spwnd.aulora",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.spwnd.aulora",
      "adaptiveIcon": {
        "backgroundColor": "#18181A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "googleServicesFile": "./android/app/google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F5A45B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aulora uses your photos so you can share them in messages.",
          "cameraPermission": "Aulora uses the camera so you can take a photo to share in a message."
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "privacyPolicyUrl": "https://aulora.chark1es.dev/docs/privacy"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
