{
  "expo": {
    "name": "Aulora",
    "slug": "aulora",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "aulora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.aulora.ios"
    },
    "android": {
      "package": "app.aulora.android",
      "adaptiveIcon": {
        "backgroundColor": "#18181A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F5A45B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aulora uses your photos so you can share them in messages.",
          "cameraPermission": "Aulora uses the camera so you can take a photo to share in a message."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
