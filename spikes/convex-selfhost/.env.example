# Copy to .env and fill in. Convex self-hosted local dev.
# Instance name -> Postgres database name is derived by replacing "-" with "_".
# e.g. INSTANCE_NAME=aulora-spike => database aulora_spike
INSTANCE_NAME=aulora-spike

# Stable secret used to encrypt/derive instance data. Generate with:
#   openssl rand -hex 32
INSTANCE_SECRET=replace-with-64-hex-chars

# Origins advertised by the backend. The .env is used by BOTH the backend
# container and the dashboard (NEXT_PUBLIC_DEPLOYMENT_URL).
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

RUST_LOG=info
